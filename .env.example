# 복사해서 .env 로 저장 (git 커밋 금지). GitHub Actions는 Secrets에 동일 이름으로 등록.

SERPAPI_KEY=
GEMINI_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=          # claude.ai 구독과 별개, 신규 발급 필요 (§9)

# 결과 저장 (선택) - 미설정 시 data/*.jsonl 로컬 저장만
GOOGLE_SHEETS_ID=
GOOGLE_SERVICE_ACCOUNT_JSON= # 서비스계정 키 JSON 문자열 전체

# 알림 (선택)
SLACK_WEBHOOK_URL=
ALERT_EMAIL_TO=

# 자사 트래픽 (2차)
GSC_SITE_URL=
