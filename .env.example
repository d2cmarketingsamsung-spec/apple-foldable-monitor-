# 복사해서 .env 로 저장 (git 커밋 금지). GitHub Actions는 Secrets에 동일 이름으로 등록.

# ---- 수집 API ----
SERPAPI_KEY=                # SERP + AI Overview (daily)
GEMINI_API_KEY=             # LLM 언급 - Google AI Studio (무료)
# OPENAI_API_KEY=           # 유료라 미사용 (settings.yaml providers 에 추가 시 필요)
# ANTHROPIC_API_KEY=        # 유료라 미사용

# ---- 리포트 이메일 (Excel 첨부 발송) ----
REPORT_EMAIL_TO=            # 수신 주소 (쉼표로 여러 명)
SMTP_USER=                  # 발신 Gmail 주소
SMTP_PASS=                  # Gmail 앱 비밀번호 16자리 (일반 비번 아님)
SMTP_HOST=smtp.gmail.com    # 기본값, 그대로 두면 됨
SMTP_PORT=465

# ---- 뉴스 (2차, 선택) ----
GOOGLE_ALERTS_FEEDS=        # Google Alerts RSS URL, 쉼표 구분

# ---- 알림 (선택, Slack 쓸 경우만) ----
SLACK_WEBHOOK_URL=
